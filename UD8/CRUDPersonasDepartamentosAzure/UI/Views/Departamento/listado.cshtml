@model IEnumerable<Domain.Entities.Departamento>

@{
    ViewData["Title"] = "listado";
}

<h1>listado</h1>

<p>
    <a asp-action="crear">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nombre)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.nombre)
            </td>
            <td>
                    @Html.ActionLink("Edit", "editar", new { id = item.id }) |
                    @Html.ActionLink("Details", "detalle", new { id = item.id }) |
                    @Html.ActionLink("Delete", "eliminar", new { id = item.id })
            </td>
        </tr>
}
    </tbody>
</table>
